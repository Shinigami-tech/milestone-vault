# Created for you by `npm run setup:testnet`. Testnet only. Never commit the real .env.
NEAR_NETWORK=testnet
# NEAR_RPC=https://test.rpc.fastnear.com
VAULT_CONTRACT=
AUDITOR_ACCOUNT=
# A FUNCTION-CALL key: may only call `report` on VAULT_CONTRACT
AUDITOR_KEY=
DEMO_CLIENT_ACCOUNT=
DEMO_CLIENT_KEY=
DEMO_FREELANCER_ACCOUNT=
DEMO_FREELANCER_KEY=
# Optional private inference for the audit note (https://cloud.near.ai). Verdicts never depend on it.
NEARAI_API_KEY=
NEARAI_MODEL=
PORT=8090
# Where the sandbox reaches the demo sites. With Docker on Linux the host is 172.17.0.1:
# SITES_URL=http://172.17.0.1:8090/sites
# MV_ALLOW_HOSTS=172.17.0.1
# SD_DRIVER=local   # run the browser without Docker (development only)
